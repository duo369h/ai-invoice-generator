  "core_principles": [
    {"id": "COMPLEXITY_STAYS_WITH_CORVIOZ", "statement": "Corvioz carries product complexity so the photographer can stay focused."},
    {"id": "FOCUS_STAYS_WITH_PHOTOGRAPHER", "statement": "The experience keeps the photographer focused on current work and decisions."},
    {"id": "DASHBOARD_IS_NOT_FEATURE_DIRECTORY", "statement": "The Dashboard focuses attention on work rather than listing every feature."},
    {"id": "DASHBOARD_FOCUSES", "statement": "The Dashboard answers what needs attention, what is in progress, and what matters next."},
    {"id": "WORKSPACE_DOES_WORK", "statement": "Project / Quote Workspace is the place where substantive work happens."},
    {"id": "DETAIL_HOLDS_COMPLEXITY", "statement": "Detailed views hold complexity without burdening the overview."},
    {"id": "PREVIEW_HANDLES_CLIENT_OUTPUT", "statement": "Preview handles client-facing output and presentation."},
    {"id": "SETTINGS_HOLD_LOW_FREQUENCY_CONFIGURATION", "statement": "Settings contain low-frequency configuration."},
    {"id": "INTELLIGENCE_APPEARS_CONTEXTUALLY", "statement": "Intelligence appears beside the relevant business context."},
    {"id": "STATUS_TO_NEXT_ACTION", "statement": "Status should connect visibly to the next useful action."},
    {"id": "ATTENTION_BUDGET", "statement": "The interface spends visual attention deliberately."},
    {"id": "PROGRESSIVE_DISCLOSURE", "statement": "Expose decisions first, summaries next, and detailed fields when needed."},
    {"id": "QUIET_WORKSPACE", "statement": "The workspace remains calm and avoids persistent visual noise."},
    {"id": "WORK_OBJECT_OVER_PAGE_TITLE", "statement": "Current work and current decisions outrank page titles in visual hierarchy."},
    {"id": "SECONDARY_ACTIONS_RECEDE", "statement": "Secondary actions recede until needed through row interaction or menus."},
    {"id": "INTERACTIVE_SURFACE", "statement": "Interactive surfaces are flat at rest and subtly elevated on interaction."},
    {"id": "ACTIVE_EDITING", "statement": "Active editing has a clear lightweight visual indicator."},
    {"id": "WHITESPACE_AROUND_CONTENT_NOT_INSIDE_RELATIONSHIPS", "statement": "Whitespace surrounds content without separating related information."},
    {"id": "LIST_ROW_FIRST", "statement": "High-scan document surfaces use rows as the primary interaction unit."},
    {"id": "BUSINESS_DATA_GENERATES_CLIENT_OUTPUT", "statement": "Client-facing output is generated from business data rather than duplicated manually."},
    {"id": "ENTITY_FIRST_TO_ACTION_WORK_FIRST", "statement": "The flow moves from identifying the relevant entity to the action and work."}
  ],
